{
    "version": "1.00",
    "capture": {
        "interface": "eth0",
        "bpf_filter": "",
        "snaplen": 65535,
        "promiscuous_mode": true,
        "buffer_size": 4096,
        "max_packets_per_second": 10000,
        "protocol_allow_list": [],
        "protocol_deny_list": [],
        "pcap_output_dir": "captures/"
    },
    "api": {
        "host": "0.0.0.0",
        "port": 8000,
        "reload": false,
        "workers": 1
    },
    "database": {
        "url_env_var": "DATABASE_URL",
        "default_url": "sqlite:///./network_defender.db",
        "echo": false
    },
    "dashboard": {
        "host": "0.0.0.0",
        "port": 3000,
        "default_theme": "dark"
    },
    "detection": {
        "evaluation_interval_seconds": 5.0,
        "evaluate_rules": true
    },
    "threat_intel": {
        "enabled": true,
        "providers": [
            "abuseipdb",
            "ip_api_geo",
            "ip_api_asn",
            "whois"
        ],
        "cache_ttl_seconds": 86400.0,
        "cache_max_entries": 10000,
        "breaker_failure_threshold": 5,
        "breaker_reset_seconds": 300.0,
        "http_timeout_seconds": 10.0,
        "enrich_private_ips": false
    },
    "maintenance": {
        "statistics_enabled": true,
        "statistics_interval_seconds": 60.0,
        "retention_enabled": true,
        "retention_interval_seconds": 3600.0
    },
    "rules_dir": "rules/",
    "config_dir": "config/",
    "retention_days": 30
}
