# Copy to .env and fill in. Only secrets and machine-specific values belong
# here; everything else lives in config/*.json. See docs/CONFIGURATION.md.

# Database
# Overrides config/setup.json -> database.default_url.
DATABASE_URL=sqlite:///./network_defender.db

# API authentication
# When unset, the REST API and live WebSocket are unauthenticated. Setting it
# makes an API key mandatory on every endpoint except the health probes.
API_KEY=your-secret-api-key-here

# Threat intel credentials
# ip-api.com and rdap.org need no credentials. AbuseIPDB is skipped
# automatically when this key is absent, rather than failing.
ABUSEIPDB_API_KEY=your-abuseipdb-key

# Any other setting: ND__SECTION__KEY
# Every field in config/setup.json can be overridden by an environment
# variable named for its path, which is how you change a value per host
# without editing a versioned file. Values are coerced to the field's type and
# validated at startup, so a bad one fails fast and names itself.
#
#   ND__CAPTURE__INTERFACE=eth1
#   ND__API__PORT=9000
#   ND__THREAT_INTEL__ENABLED=false
#
# Note there is no API_HOST or API_PORT. Earlier versions of this file listed
# them; nothing ever read them, so setting one silently did nothing. Use
# ND__API__HOST and ND__API__PORT.
